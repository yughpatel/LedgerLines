# Copy to .env.local to override. Not needed for normal development or production.

# Where the app sends API calls. Defaults to /api, which the Vite dev server (and
# Vercel in production) forwards to the backend. Only set this to call an API on
# another origin directly, and then set the backend's REFRESH_COOKIE_PATH=/auth
# and add this app's origin to its CORS_ORIGINS.
# VITE_API_BASE_URL=http://localhost:8000
