# Copy to .env and replace every value. Never commit .env.
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/ledgerlines
SECRET_KEY=<random-string-at-least-32-characters>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_SECRET_KEY=<different-random-string-at-least-32-characters>
REFRESH_TOKEN_EXPIRE_DAYS=7

# development, test or production (anything else fails at startup).
# production makes the refresh cookie Secure and refuses to start with unsafe
# values: secrets under 32 characters or equal to each other, or CORS_ORIGINS
# that are "*" or not https://
ENVIRONMENT=development

# Optional. Browser origins allowed to call the API directly, comma-separated.
# The frontend goes through its own /api proxy, which is same-origin, so in
# production this can be empty (CORS_ORIGINS=) unless something else calls the API.
CORS_ORIGINS=http://localhost:3000

# Optional. Where the browser sends the refresh cookie. /api/auth matches the
# frontend calling the API through /api (Vite in development, Vercel in production).
# Use /auth only if the browser calls the API directly, without the proxy.
REFRESH_COOKIE_PATH=/api/auth
