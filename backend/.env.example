# Copy to .env and replace every value. Never commit .env.
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/ledgerlines
SECRET_KEY=<random-string-at-least-32-characters>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_SECRET_KEY=<different-random-string-at-least-32-characters>
REFRESH_TOKEN_EXPIRE_DAYS=7
# Optional. "production" makes the refresh cookie Secure.
ENVIRONMENT=development
