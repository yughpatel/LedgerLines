# Copy to .env and replace every value. Never commit .env.
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/ledgerlines
SECRET_KEY=<long-random-string>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_SECRET_KEY=<different-long-random-string>
REFRESH_TOKEN_EXPIRE_DAYS=7
# Optional. "production" makes the refresh cookie Secure.
ENVIRONMENT=development
